enum UserRole {
  admin
  user
}

model User {
  id                 String      @id @default(uuid())
  fullName           String
  username           String      @unique
  email              String      @unique
  password           String
  role               UserRole    @default(user)
  mustChangePassword Boolean     @default(false)
  lastLogin          DateTime?
  sessions           Session[]
  ownedWorkspaces    Workspace[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}