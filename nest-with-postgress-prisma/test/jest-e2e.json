{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": { "rewriteRelativeImportExtensions": false } }
    ]
  },
  "setupFiles": ["<rootDir>/setup-env.ts"]
}
